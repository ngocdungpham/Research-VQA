[Unit]
Description=Bronchoscopy VQA v4.3 production generator
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ailab/Documents/KC4.0_Final_annots_data_png
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ngocdung/.config/bronchoscopy-vqa-v4-3.env
ExecStart=/usr/bin/python3 /home/ailab/Documents/KC4.0_Final_annots_data_png/dataset_versioning/run_vqa_v4_3_production.py run
Restart=on-failure
RestartSec=120
TimeoutStopSec=330
KillSignal=SIGTERM
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target

